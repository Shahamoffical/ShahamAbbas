{
  "name": "website-portfolio",
  "version": "1.0.0",
  "description": "Personal Portfolio Website built with HTML, Tailwind CSS, JavaScript and Node.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/output.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./public/output.css --watch",
    "dev": "npm run build:css && node server.js"
  },
  "keywords": [
    "portfolio",
    "nodejs",
    "tailwindcss"
  ],
  "author": "Shaham",
  "license": "MIT",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "mongoose": "^9.3.0",
    "nodemailer": "^8.0.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1"
  }
}
